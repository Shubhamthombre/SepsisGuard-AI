# Port number for the backend server to run on
PORT=5000

# Connection string for your MongoDB database
# - If running MongoDB locally: mongodb://localhost:27017/sepsisguard
# - If using MongoDB Atlas (Cloud): mongodb+srv://<username>:<password>@cluster.../sepsisguard?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/sepsisguard

# Secret key used for signing JSON Web Tokens (JWT) for user login/authentication.
JWT_SECRET=change_this_to_a_long_random_secret_key_for_security

# Optional Email Configuration for Doctor/Clinician Risk Alerts (SMTP)
# If left blank, email alerts will be disabled by default and logged to server console.
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_USER=your_email@example.com
EMAIL_PASS=your_email_password
EMAIL_FROM="SepsisGuard AI <noreply@sepsisguard.ai>"
APP_URL=http://localhost:5173
